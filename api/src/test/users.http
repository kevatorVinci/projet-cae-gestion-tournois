@baseUrl = http://localhost:3000

### Login admin seed (insert.sql)
POST {{baseUrl}}/auths/login
Content-Type: application/json

{
  "email": "admin@vinci.be",
  "password": "admin"
}

### Register a new user
POST {{baseUrl}}/auths/register
Content-Type: application/json

{
  "email": "newuser@vinci.be",
  "password": "password123",
  "tag": "newbie",
  "specialty": "support",
  "profileImage": "avatar-1.png"
}

### Login the new user
POST {{baseUrl}}/auths/login
Content-Type: application/json

{
  "email": "newuser@vinci.be",
  "password": "password123"
}

### Update profile (no JWT required on endpoint currently)
PUT {{baseUrl}}/auths/update
Content-Type: application/json

{
  "email": "newuser@vinci.be",
  "specialty": "captain",
  "profileImage": "avatar-2.png",
  "oldPassword": "password123",
  "newPassword": "password1234"
}

### Login should fail with wrong password
POST {{baseUrl}}/auths/login
Content-Type: application/json

{
  "email": "newuser@vinci.be",
  "password": "wrong-password"
}

